#!/usr/bin/env bash
set -e

# ez-linux-scripts installer (online)
# Downloads the repository as an archive, extracts it to a temporary directory,
# performs the full installation, then removes the temporary files.

# Target directories
BIN_DIR="$HOME/.local/bin"
APP_DIR="$HOME/.local/share/applications"

# Remote repository
REPO_URL="https://github.com/cptodix/ez-linux-scripts"
BRANCH="main"

DRY_RUN=false
UNINSTALL=false

# Parse arguments
for arg in "$@"; do
    case "$arg" in
        --dry-run)
            DRY_RUN=true
            ;;
        --uninstall)
            UNINSTALL=true
            ;;
        --help|-h)
            echo "Usage: $0 [--dry-run] [--uninstall]"
            echo "  --uninstall   Remove all scripts from $BIN_DIR and shortcuts from $APP_DIR"
            echo "  --dry-run     Preview installation actions without making changes"
            exit 0
            ;;
    esac
done

# --- Fetch the repository into a temporary directory ---
if [ "$DRY_RUN" = true ]; then
    echo "[DRY RUN MODE - No changes will be written]"
fi

# Make sure required tools are available
if ! command -v tar &> /dev/null; then
    echo "Error: 'tar' is not available." >&2
    exit 1
fi
if ! command -v curl &> /dev/null && ! command -v wget &> /dev/null; then
    echo "Error: neither 'curl' nor 'wget' is available." >&2
    exit 1
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ez-linux-scripts.XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT

echo "========================================="
echo " Fetching ez-linux-scripts ($BRANCH branch)"
echo "========================================="

TMP_ARCHIVE="$TMP_DIR/repo.tar.gz"
if command -v curl &> /dev/null; then
    curl -fsSL "$REPO_URL/archive/refs/heads/$BRANCH.tar.gz" -o "$TMP_ARCHIVE"
else
    wget -q "$REPO_URL/archive/refs/heads/$BRANCH.tar.gz" -O "$TMP_ARCHIVE"
fi

tar -xzf "$TMP_ARCHIVE" -C "$TMP_DIR" --strip-components=1

# The extracted repository now lives in this temporary directory
REPO_DIR="$TMP_DIR"

# --- Uninstall ---
if [ "$UNINSTALL" = true ]; then
    echo "========================================="
    echo " Uninstalling scripts and shortcuts..."
    echo "========================================="
    
    # Mirror the install logic: only remove what install actually deploys.
    # Ignore the fonts installer and any non-script files (never installed).
    for script_file in "$REPO_DIR"/scripts/*; do
        [ -f "$script_file" ] || continue
        
        script_name=$(basename "$script_file")
        
        [ "$script_name" = "install-win-fonts" ] && continue
        head -1 "$script_file" | grep -q '^#!' || continue
        
        target_bin="$BIN_DIR/$script_name"
        target_desktop="$APP_DIR/${script_name}.desktop"
        
        if [ -f "$target_bin" ]; then
            echo " -> Removing binary: $target_bin"
            [ "$DRY_RUN" = false ] && rm -f "$target_bin"
        fi
        if [ -f "$target_desktop" ]; then
            echo " -> Removing desktop shortcut: $target_desktop"
            [ "$DRY_RUN" = false ] && rm -f "$target_desktop"
        fi
    done
    
    # Remove the self-contained updater that install places in ~/.local/bin
    target_update="$BIN_DIR/update-scripts"
    if [ -f "$target_update" ]; then
        echo " -> Removing binary: $target_update"
        [ "$DRY_RUN" = false ] && rm -f "$target_update"
    fi
    
    if command -v update-desktop-database &> /dev/null && [ "$DRY_RUN" = false ]; then
        update-desktop-database "$APP_DIR" 2>/dev/null || true
    fi
    
    echo "========================================="
    echo " Uninstallation complete!"
    echo "========================================="
    exit 0
fi

# --- Install ---
echo "========================================="
echo " Installing scripts to $BIN_DIR"
echo " and generating .desktop shortcuts in $APP_DIR"
echo "========================================="

[ "$DRY_RUN" = false ] && mkdir -p "$BIN_DIR"
[ "$DRY_RUN" = false ] && mkdir -p "$APP_DIR"

# Dynamically iterate over all script files in scripts/
for script_file in "$REPO_DIR"/scripts/*; do
    [ -f "$script_file" ] || continue
    
    script_name=$(basename "$script_file")
    
    # Skip one-time scripts — run manually after install instead of installing to PATH
    [ "$script_name" = "install-win-fonts" ] && continue
    
    # Skip files without a shebang line (e.g., docs, markdown, etc.)
    head -1 "$script_file" | grep -q '^#!' || continue
    
    target_path="$BIN_DIR/$script_name"
    
    echo " -> Installing script: $script_name -> $target_path"
    if [ "$DRY_RUN" = false ]; then
        cp -f "$script_file" "$target_path"
        chmod +x "$target_path"
    fi
    
    # Generate .desktop shortcut
    desktop_file="$APP_DIR/${script_name}.desktop"
    pretty_name=$(echo "$script_name" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2)); print}')
    
    echo " -> Creating desktop shortcut: $desktop_file"
    if [ "$DRY_RUN" = false ]; then
        cat << EOF > "$desktop_file"
[Desktop Entry]
Type=Application
Name=$pretty_name
Exec=$target_path
Terminal=true
Categories=Utility;Application;
Comment=Script: $pretty_name
EOF
        chmod +x "$desktop_file"
    fi
done

# Update desktop database if available
if command -v update-desktop-database &> /dev/null && [ "$DRY_RUN" = false ]; then
    update-desktop-database "$APP_DIR" 2>/dev/null || true
fi

echo "========================================="
echo " Installation and shortcut generation complete!"

# Prompt user to run install-win-fonts
if [ "$DRY_RUN" = false ]; then
    echo ""
    echo "========================================="
    echo -n "Would you like to install Windows fonts now? [y/N]: "
    read -r run_fonts < /dev/tty 2>/dev/null || true
    if [[ "$run_fonts" =~ ^[Yy]$ ]]; then
        echo ""
        echo "========================================="
        echo " Executing: install-win-fonts"
        echo "========================================="
        bash "$REPO_DIR/scripts/install-win-fonts"
    else
        echo "Skipping Windows fonts installation. You can run it manually later with: install-win-fonts"
    fi
fi

# Add goto alias to ~/.bashrc if not already present
if [ "$DRY_RUN" = false ]; then
    BASHRC="$HOME/.bashrc"
    if [ -f "$BASHRC" ] && grep -qxF "alias goto='. goto'" "$BASHRC"; then
        echo " -> goto alias already present in $BASHRC"
    else
        echo "" >> "$BASHRC"
        echo "# Goto directory bookmark manager alias" >> "$BASHRC"
        echo "alias goto='. goto'" >> "$BASHRC"
        echo " -> Added goto alias to $BASHRC"
    fi
else
    echo "[DRY RUN] Would add goto alias to ~/.bashrc"
fi

# Install self-contained online update-scripts to ~/.local/bin
if [ "$DRY_RUN" = false ]; then
    cp -f "$REPO_DIR/update-scripts" "$BIN_DIR/update-scripts"
    chmod +x "$BIN_DIR/update-scripts"
    echo " -> Installed update-scripts to $BIN_DIR/update-scripts"
else
    echo "[DRY RUN] Would install update-scripts to $BIN_DIR/update-scripts"
fi

echo "========================================="
echo " Temporary files cleaned up automatically."
echo "========================================="
