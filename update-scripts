#!/usr/bin/env bash
set -e

# ez-linux-scripts updater (online)
# Downloads the latest repository as an archive, extracts it to a temporary
# directory, syncs the installed scripts from there, then removes the temp files.

# Target directories
BIN_DIR="$HOME/.local/bin"
APP_DIR="$HOME/.local/share/applications"

# Remote repository
REPO_URL="https://github.com/cptodix/ez-linux-scripts"
BRANCH="main"

mkdir -p "$BIN_DIR" "$APP_DIR"

echo "========================================="
echo " Fetching latest ez-linux-scripts ($BRANCH branch)"
echo "========================================="

# Make sure required tools are available
if ! command -v tar &> /dev/null; then
    echo "Error: 'tar' is not available." >&2
    exit 1
fi
if ! command -v curl &> /dev/null && ! command -v wget &> /dev/null; then
    echo "Error: neither 'curl' nor 'wget' is available." >&2
    exit 1
fi

# Download and extract the repository into a temporary directory
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ez-linux-scripts-update.XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT

TMP_ARCHIVE="$TMP_DIR/repo.tar.gz"
if command -v curl &> /dev/null; then
    curl -fsSL "$REPO_URL/archive/refs/heads/$BRANCH.tar.gz" -o "$TMP_ARCHIVE"
else
    wget -q "$REPO_URL/archive/refs/heads/$BRANCH.tar.gz" -O "$TMP_ARCHIVE"
fi

tar -xzf "$TMP_ARCHIVE" -C "$TMP_DIR" --strip-components=1

# Sync the installed scripts from the temporary extraction
REPO_DIR="$TMP_DIR"

echo "========================================="
echo " Updating scripts from remote repository"
echo "========================================="

updated=0
skipped=0

for script_file in "$REPO_DIR"/scripts/*; do
    [ -f "$script_file" ] || continue
    
    script_name=$(basename "$script_file")
    
    # Skip one-time scripts — not installed to PATH
    [ "$script_name" = "install-win-fonts" ] && continue
    
    # Skip files without a shebang line (e.g., docs, markdown, etc.)
    head -1 "$script_file" | grep -q '^#!' || continue
    
    target_path="$BIN_DIR/$script_name"
    desktop_file="$APP_DIR/${script_name}.desktop"
    
    # Check if there's an actual change
    if [ -f "$target_path" ] && cmp -s "$script_file" "$target_path"; then
        skipped=$((skipped + 1))
        continue
    fi
    
    echo " -> Updating script: $script_name -> $target_path"
    cp -f "$script_file" "$target_path"
    chmod +x "$target_path"
    updated=$((updated + 1))
    
    # Regenerate .desktop shortcut
    pretty_name=$(echo "$script_name" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2)); print}')
    
    echo " -> Refreshing desktop shortcut: $desktop_file"
    cat << EOF > "$desktop_file"
[Desktop Entry]
Type=Application
Name=$pretty_name
Exec=$target_path
Terminal=true
Categories=Utility;Application;
Comment=Script: $pretty_name
EOF
    chmod +x "$desktop_file"
done

# Update desktop database if available
if command -v update-desktop-database &> /dev/null; then
    update-desktop-database "$APP_DIR" 2>/dev/null || true
fi

echo "========================================="
echo " Update complete!"
echo " Updated: $updated"
echo " Skipped (up-to-date): $skipped"
echo "========================================="
