#!/usr/bin/env bash
set -e

# Function to find all Steam library paths
get_steam_libraries() {
    local base_paths=(
        "$HOME/.local/share/Steam"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
    )
    
    local libs=()
    for bp in "${base_paths[@]}"; do
        if [ -d "$bp" ]; then
            libs+=("$bp")
            local vdf="$bp/steamapps/libraryfolders.vdf"
            if [ -f "$vdf" ]; then
                while IFS= read -r line; do
                    if [[ "$line" =~ \"path\"[[:space:]]+\"([^\"]+)\" ]]; then
                        local p="${BASH_REMATCH[1]}"
                        p="${p//\\\\/\/}"
                        if [ -d "$p" ] && [[ ! " ${libs[*]} " =~ " ${p} " ]]; then
                            libs+=("$p")
                        fi
                    fi
                done < "$vdf"
            fi
        fi
    done
    echo "${libs[@]}"
}

# Function to parse installed games across all libraries
get_installed_games() {
    local libs=($(get_steam_libraries))
    for lib in "${libs[@]}"; do
        local steamapps="$lib/steamapps"
        if [ -d "$steamapps" ]; then
            for acf in "$steamapps"/appmanifest_*.acf; do
                [ -f "$acf" ] || continue
                local appid=""
                local name=""
                while IFS= read -r line; do
                    if [[ "$line" =~ \"appid\"[[:space:]]+\"([0-9]+)\" ]]; then
                        appid="${BASH_REMATCH[1]}"
                    elif [[ "$line" =~ \"name\"[[:space:]]+\"([^\"]+)\" ]]; then
                        name="${BASH_REMATCH[1]}"
                    fi
                done < "$acf"
                if [ -n "$appid" ] && [ -n "$name" ]; then
                    echo "$appid|$name|$lib"
                fi
            done
        fi
    done | sort -t'|' -k2
}

# Get the latest backup for a given appid inside its compatdata/backup folder
find_latest_backup() {
    local appid="$1"
    local compatdata_dir="$2"
    local backup_dir="$compatdata_dir/backup"
    
    if [ ! -d "$backup_dir" ]; then
        echo ""
        return
    fi
    
    local latest=""
    for f in "$backup_dir"/${appid}_*.tar.gz; do
        [ -f "$f" ] || continue
        latest="$f"
    done
    echo "$latest"
}

# Handle restore mode (--restore <backup-file>)
do_restore() {
    local backup_file="$1"
    if [ ! -f "$backup_file" ]; then
        echo "Error: Backup file '$backup_file' not found."
        exit 1
    fi
    
    echo "Scanning installed games for restore target..."
    local games=()
    while IFS='|' read -r appid name lib; do
        [ -n "$appid" ] && games+=("$appid|$name|$lib")
    done < <(get_installed_games)
    
    if [ ${#games[@]} -eq 0 ]; then
        echo "Error: No installed Steam games found."
        exit 1
    fi
    
    echo "========================================="
    echo " Select Game to Restore Backup Into:"
    echo "========================================="
    for i in "${!games[@]}"; do
        IFS='|' read -r appid name lib <<< "${games[$i]}"
        echo "$((i+1))) $name (AppID: $appid)"
    done
    
    read -p "Enter game number: " choice
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#games[@]}" ]; then
        echo "Invalid selection."
        exit 1
    fi
    
    IFS='|' read -r appid name lib <<< "${games[$((choice-1))]}"
    local compatdata_dir="$lib/steamapps/compatdata/$appid"
    
    mkdir -p "$compatdata_dir"
    echo "Restoring backup into: $compatdata_dir"
    tar -xzf "$backup_file" -C "$compatdata_dir"
    echo "Restore completed successfully for $name!"
    exit 0
}

# Parse flags
if [ "$1" = "--restore" ]; then
    if [ -z "$2" ]; then
        echo "Usage: proton-reset --restore <backup-tar-gz-file>"
        exit 1
    fi
    do_restore "$2"
fi

echo "Scanning Steam libraries and installed games..."
games=()
while IFS='|' read -r appid name lib; do
    [ -n "$appid" ] && games+=("$appid|$name|$lib")
done < <(get_installed_games)

if [ ${#games[@]} -eq 0 ]; then
    echo "Error: No installed Steam games found."
    exit 1
fi

echo "========================================="
echo " Installed Steam Games:"
echo "========================================="
for i in "${!games[@]}"; do
    IFS='|' read -r appid name lib <<< "${games[$i]}"
    echo "$((i+1))) $name (AppID: $appid)"
done

read -p "Enter game number(s) to reset compatdata (space-separated): " choices

for choice in $choices; do
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#games[@]}" ]; then
        echo "Invalid selection: $choice"
        continue
    fi
    
    IFS='|' read -r appid name lib <<< "${games[$((choice-1))]}"
    compatdata_dir="$lib/steamapps/compatdata/$appid"
    
    echo ""
    echo "-----------------------------------------"
    echo " Game: $name (AppID: $appid)"
    echo " Target Compatdata Path: $compatdata_dir"
    echo "-----------------------------------------"
    
    if [ ! -d "$compatdata_dir" ]; then
        echo "Notice: Compatdata folder does not exist yet for this game."
        continue
    fi
    
    # 1. Backup common savegame folders into compatdata/backup/
    backup_dir="$compatdata_dir/backup"
    mkdir -p "$backup_dir"
    
    # Truncate game name to first 30 chars, replace spaces with underscores
    truncated_name="${name:0:30}"
    truncated_name="${truncated_name// /_}"
    backup_filename="${appid}_$(date +%Y%m%d_%H%M%S)_${truncated_name}.tar.gz"
    backup_path="$backup_dir/$backup_filename"
    
    echo "Backing up common savegame folders..."
    
    # Define common savegame paths inside compatdata
    save_paths=(
        "savegames"
        "saves"
        "savedata"
        "SavedArts"
        "Documents"
        "AppData/Local"
        "AppData/Roaming"
        "pfx/drive_c/users/steamuser/Documents"
        "pfx/drive_c/users/steamuser/Saved Games"
        "pfx/drive_c/users/steamuser/AppData/Local"
        "pfx/drive_c/users/steamuser/AppData/Roaming"
        "pfx/drive_c/ProgramData"
    )
    
    # Collect existing paths and their display names
    found_paths=()
    found_names=()
    for sp in "${save_paths[@]}"; do
        if [ -d "$compatdata_dir/$sp" ]; then
            found_paths+=("$sp")
            found_names+=("$sp")
        fi
    done
    
    if [ ${#found_paths[@]} -eq 0 ]; then
        echo "No common savegame folders found; skipping backup."
    else
        # Use a temp directory to preserve the exact folder structure
        temp_dir=$(mktemp -d)
        
        # Copy each found path into temp_dir preserving relative structure
        for idx in "${!found_paths[@]}"; do
            src="${found_paths[$idx]}"
            dest_name="${found_names[$idx]}"
            mkdir -p "$temp_dir/$dest_name"
            cp -a "$compatdata_dir/$src/." "$temp_dir/$dest_name/" 2>/dev/null || true
        done
        
        pushd "$temp_dir" > /dev/null
        tar -czf "$backup_path" . 2>/dev/null
        popd > /dev/null
        
        rm -rf "$temp_dir"
        
        echo "Backup saved to: $backup_path"
    fi
    
    # 2. Confirmation before deletion
    read -p "Are you SURE you want to delete compatdata for '$name'? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        echo "Deleting: $compatdata_dir"
        rm -rf "$compatdata_dir"
        echo "Successfully reset compatdata for $name."
    else
        echo "Skipped deletion for $name."
        continue
    fi
    
    # 3. Offer immediate restore from the backup just created
    echo ""
    read -p "Would you like to restore the backup immediately? [y/N]: " restore_now
    if [[ "$restore_now" =~ ^[Yy]$ ]]; then
        # Recreate compatdata dir (was deleted above)
        mkdir -p "$compatdata_dir"
        echo "Restoring backup into: $compatdata_dir"
        tar -xzf "$backup_path" -C "$compatdata_dir"
        echo "Restore completed successfully for $name!"
    fi
done

echo ""
echo "========================================="
echo " Proton reset process finished!"
echo "========================================="
