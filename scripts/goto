#!/usr/bin/env bash
set -e

# Configuration
MAX_BOOKMARKS=20
# Bookmarks are stored as comments below between # BOOKMARK_START and # BOOKMARK_END markers
# Each bookmark line format: # B:<absolute path>

SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# Read the entire script into a variable to avoid stdin conflicts
SCRIPT_CONTENT="$(cat "$SCRIPT_PATH")"

# --- Helper Functions ---

load_bookmarks() {
    bookmarks=()
    local in_bookmarks=false
    while IFS= read -r line; do
        if [[ "$line" == "# BOOKMARK_START" ]]; then
            in_bookmarks=true
            continue
        fi
        if [[ "$line" == "# BOOKMARK_END" ]]; then
            in_bookmarks=false
            continue
        fi
        if [ "$in_bookmarks" = true ] && [[ "$line" =~ ^#\ B: ]]; then
            local path="${line#\# B:}"
            bookmarks+=("$path")
        fi
    done <<< "$SCRIPT_CONTENT"
}

save_bookmarks() {
    local tmp_file
    tmp_file=$(mktemp)
    local in_bookmarks=false
    local bookmark_lines=()
    
    # Collect existing bookmark lines from SCRIPT_CONTENT
    while IFS= read -r line; do
        if [[ "$line" == "# BOOKMARK_START" ]]; then
            in_bookmarks=true
            continue
        fi
        if [[ "$line" == "# BOOKMARK_END" ]]; then
            in_bookmarks=false
            continue
        fi
        if [ "$in_bookmarks" = true ] && [[ "$line" =~ ^#\ B: ]]; then
            bookmark_lines+=("$line")
        fi
    done <<< "$SCRIPT_CONTENT"
    
    # Write everything except old bookmark block, then insert new ones
    in_bookmarks=false
    while IFS= read -r line; do
        if [[ "$line" == "# BOOKMARK_START" ]]; then
            in_bookmarks=true
            continue
        fi
        if [[ "$line" == "# BOOKMARK_END" ]]; then
            in_bookmarks=false
            echo "# BOOKMARK_END" >> "$tmp_file"
            continue
        fi
        if [ "$in_bookmarks" = true ]; then
            continue
        fi
        echo "$line" >> "$tmp_file"
    done <<< "$SCRIPT_CONTENT"
    
    # Insert new bookmarks
    echo "# BOOKMARK_START" >> "$tmp_file"
    for i in "${!bookmarks[@]}"; do
        echo "# B:${bookmarks[$i]}" >> "$tmp_file"
    done
    echo "# BOOKMARK_END" >> "$tmp_file"
    
    # Preserve permissions and overwrite
    chmod +x "$tmp_file"
    mv "$tmp_file" "$SCRIPT_PATH"
    
    # Update SCRIPT_CONTENT to reflect the new file
    SCRIPT_CONTENT="$(cat "$SCRIPT_PATH")"
}

display_menu() {
    load_bookmarks

    echo "========================================="
    echo " Directory Bookmarks ($MAX_BOOKMARKS limit)"
    echo "========================================="
    echo ""
    
    if [ ${#bookmarks[@]} -eq 0 ]; then
        echo "  No bookmarks saved yet."
    else
        for i in "${!bookmarks[@]}"; do
            num=$((i + 1))
            letter=$(printf '\\%03o' $((num + 96)) | tr -d '\\')
            dir="${bookmarks[$i]}"
            dir_name=$(basename "$dir")
            if [ "$dir" = "$(pwd)" ]; then
                echo "  $num) [$letter] $dir_name * (current)"
            else
                echo "  $num) [$letter] $dir_name"
            fi
        done
    fi
    
    echo ""
    echo "  [a] Add bookmark"
    echo "  [d] Delete bookmark(s)"
    echo "  [q] Quit"
    echo ""
    echo "========================================="
}

add_bookmark() {
    echo ""
    echo "Enter directory path (press Enter to cancel):"
    read -r dir
    
    if [ -z "$dir" ]; then
        echo "Cancelled."
        return
    fi
    
    # Expand ~ to home directory
    dir="${dir/#\~/$HOME}"
    
    # Resolve to absolute path
    if [[ "$dir" != /* ]]; then
        dir="$PWD/$dir"
    fi
    dir="$(cd "$dir" 2>/dev/null && pwd)" || {
        echo "Error: Directory does not exist: $dir"
        return
    }
    
    # Check if already bookmarked
    for existing in "${bookmarks[@]}"; do
        if [ "$existing" = "$dir" ]; then
            echo "Bookmark already exists: $dir"
            return
        fi
    done
    
    # Check limit
    if [ ${#bookmarks[@]} -ge $MAX_BOOKMARKS ]; then
        echo "Error: Bookmark limit reached ($MAX_BOOKMARKS). Delete some first."
        return
    fi
    
    bookmarks+=("$dir")
    save_bookmarks
    echo "Added: $dir"
}

delete_bookmark() {
    load_bookmarks
    
    if [ ${#bookmarks[@]} -eq 0 ]; then
        echo "No bookmarks to delete."
        return
    fi
    
    echo ""
    echo "Select bookmark(s) to delete (comma-separated numbers, 'a' for all, or press Enter to cancel):"
    for i in "${!bookmarks[@]}"; do
        num=$((i + 1))
        dir_name=$(basename "${bookmarks[$i]}")
        echo "  $num) $dir_name"
    done
    echo ""
    read -r input
    
    if [ -z "$input" ]; then
        echo "Cancelled."
        return
    fi
    
    if [ "$input" = "a" ]; then
        echo "Deleting all bookmarks..."
        bookmarks=()
        save_bookmarks
        echo "All bookmarks deleted."
        return
    fi
    
    # Parse comma-separated numbers
    IFS=',' read -ra selections <<< "$input"
    deleted=0
    
    for sel in "${selections[@]}"; do
        sel=$(echo "$sel" | xargs)
        if [[ "$sel" =~ ^[0-9]+$ ]]; then
            if [ "$sel" -ge 1 ] && [ "$sel" -le ${#bookmarks[@]} ]; then
                dir_name=$(basename "${bookmarks[$((sel - 1))]}")
                echo "  Deleting: $dir_name"
                deleted=$((deleted + 1))
            else
                echo "  Invalid: $sel"
            fi
        else
            echo "  Invalid: $sel"
        fi
    done
    
    # Rebuild array excluding deleted entries
    local new_bookmarks=()
    for i in "${!bookmarks[@]}"; do
        num=$((i + 1))
        is_deleted=false
        for sel in "${selections[@]}"; do
            sel=$(echo "$sel" | xargs)
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -eq "$num" ]; then
                is_deleted=true
                break
            fi
        done
        if [ "$is_deleted" = false ]; then
            new_bookmarks+=("${bookmarks[$i]}")
        fi
    done
    
    bookmarks=("${new_bookmarks[@]}")
    save_bookmarks
    echo "Deleted $deleted bookmark(s)."
}

# --- Main Loop ---
while true; do
    display_menu
    read -r -n 1 choice
    echo ""
    # Drain remaining input (newline left by -n 1)
    read -r -t 0.1 _drain 2>/dev/null || true
    
    case "$choice" in
        [Qq])
            echo "Exiting."
            exit 0
            ;;
        [Aa])
            add_bookmark
            ;;
        [Dd])
            delete_bookmark
            ;;
        [0-9])
            num="$choice"
            load_bookmarks
            if [ -n "${bookmarks[$((num - 1))]+x}" ]; then
                dir="${bookmarks[$((num - 1))]}"
                if [ -d "$dir" ]; then
                    cd "$dir" && ls
                    exit 0
                else
                    echo "Error: Directory does not exist: $dir"
                fi
            else
                echo "Error: Bookmark $num not found."
            fi
            ;;
        [a-tA-T])
            lower=$(echo "$choice" | tr '[:upper:]' '[:lower:]')
            index=$(( $(printf '%d' "'$lower") - 96 ))
            load_bookmarks
            if [ -n "${bookmarks[$((index - 1))]+x}" ]; then
                dir="${bookmarks[$((index - 1))]}"
                if [ -d "$dir" ]; then
                    cd "$dir" && ls
                    exit 0
                else
                    echo "Error: Directory does not exist: $dir"
                fi
            else
                echo "Error: Bookmark $choice not found."
            fi
            ;;
        *)
            echo "Invalid option."
            ;;
    esac
    echo ""
    read -r -p "Press Enter to continue..." < /dev/tty 2>/dev/null || true
done

# BOOKMARK_START
# BOOKMARK_END
