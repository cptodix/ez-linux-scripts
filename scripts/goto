#!/usr/bin/env bash
set -e

# Configuration
MAX_BOOKMARKS=20
BOOKMARK_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/goto/bookmarks"

# Ensure config directory exists
mkdir -p "$(dirname "$BOOKMARK_FILE")"

# Determine if script is sourced (important for parent shell cd execution)
is_sourced=false
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    is_sourced=true
fi

# --- Helper Functions ---

load_bookmarks() {
    bookmarks=()
    if [[ -f "$BOOKMARK_FILE" ]]; then
        # Read file into array, ignoring empty lines
        while IFS= read -r line; do
            [[ -n "$line" ]] && bookmarks+=("$line")
        done < "$BOOKMARK_FILE"
    fi
}

save_bookmarks() {
    # Clear file and write array elements line by line
    > "$BOOKMARK_FILE"
    for dir in "${bookmarks[@]}"; do
        echo "$dir" >> "$BOOKMARK_FILE"
    done
}

display_menu() {
    load_bookmarks

    echo "========================================="
    echo " Directory Bookmarks ($MAX_BOOKMARKS limit)"
    echo "========================================="
    echo ""
    
    if [ ${#bookmarks[@]} -eq 0 ]; then
        echo "  No bookmarks saved yet."
    else
        for i in "${!bookmarks[@]}"; do
            num=$((i + 1))
            dir="${bookmarks[$i]}"
            if [ "$dir" = "$(pwd)" ]; then
                echo "  $num) $dir * (current)"
            else
                echo "  $num) $dir"
            fi
        done
    fi
    
    echo ""
    echo "  [a] Add bookmark"
    echo "  [d] Delete bookmark(s)"
    echo "  [q] Quit"
    echo ""
    echo "========================================="
}

add_bookmark() {
    echo ""
    echo "Enter directory path (press Enter to cancel):"
    read -r dir
    
    if [ -z "$dir" ]; then
        echo "Cancelled."
        echo -n "Press Enter to continue... "
        read -r _press_enter
    fi
    
    # Expand ~ to home directory
    dir="${dir/#\~/$HOME}"
    
    # Resolve to absolute path
    if [[ "$dir" != /* ]]; then
        dir="$PWD/$dir"
    fi
    dir="$(cd "$dir" 2>/dev/null && pwd)" || {
        echo "Error: Directory does not exist: $dir"
        echo -n "Press Enter to continue... "
        read -r _press_enter
        return
    }
    
    # Check if already bookmarked
    for existing in "${bookmarks[@]}"; do
        if [ "$existing" = "$dir" ]; then
            echo "Bookmark already exists: $dir"
            echo -n "Press Enter to continue... "
            read -r _press_enter
            return
        fi
    done
    
    # Check limit
    if [ ${#bookmarks[@]} -ge $MAX_BOOKMARKS ]; then
        echo "Error: Bookmark limit reached ($MAX_BOOKMARKS). Delete some first."
        echo -n "Press Enter to continue... "
        read -r _press_enter
        return
    fi
    
    bookmarks+=("$dir")
    save_bookmarks
    echo "Added: $dir"
    echo -n "Press Enter to continue... "
    read -r _press_enter
}

delete_bookmark() {
    load_bookmarks
    
    if [ ${#bookmarks[@]} -eq 0 ]; then
        echo "No bookmarks to delete."
        echo -n "Press Enter to continue... "
        read -r _press_enter
        return
    fi
    
    echo ""
    echo "Select bookmark(s) to delete (comma-separated numbers, 'a' for all, or press Enter to cancel):"
    for i in "${!bookmarks[@]}"; do
        num=$((i + 1))
        echo "  $num) ${bookmarks[$i]}"
    done
    echo ""
    read -r input
    
    if [ -z "$input" ]; then
        echo "Cancelled."
        echo -n "Press Enter to continue... "
        read -r _press_enter
        return
    fi
    
    if [ "$input" = "a" ]; then
        echo "Deleting all bookmarks..."
        bookmarks=()
        save_bookmarks
        echo "All bookmarks deleted."
        echo -n "Press Enter to continue... "
        read -r _press_enter
        return
    fi
    
    # Parse comma-separated numbers
    IFS=',' read -ra selections <<< "$input"
    deleted=0
    
    for sel in "${selections[@]}"; do
        sel=$(echo "$sel" | xargs)
        if [[ "$sel" =~ ^[0-9]+$ ]]; then
            if [ "$sel" -ge 1 ] && [ "$sel" -le ${#bookmarks[@]} ]; then
                echo "  Deleting: ${bookmarks[$((sel - 1))]}"
                deleted=$((deleted + 1))
            else
                echo "  Invalid: $sel"
            fi
        else
            echo "  Invalid: $sel"
        fi
    done
    
    # Rebuild array excluding deleted entries
    local new_bookmarks=()
    for i in "${!bookmarks[@]}"; do
        num=$((i + 1))
        is_deleted=false
        for sel in "${selections[@]}"; do
            sel=$(echo "$sel" | xargs)
            if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -eq "$num" ]; then
                is_deleted=true
                break
            fi
        done
        if [ "$is_deleted" = false ]; then
            new_bookmarks+=("${bookmarks[$i]}")
        fi
    done
    
    bookmarks=("${new_bookmarks[@]}")
    save_bookmarks
    echo "Deleted $deleted bookmark(s)."
    echo -n "Press Enter to continue... "
    read -r _press_enter
}

execute_cd() {
    local target_dir="$1"
    if [ -d "$target_dir" ]; then
        cd "$target_dir" && ls
        if [ "$is_sourced" = true ]; then
            return 0
        else
            # Replaces the current child process with a new shell session inside the target directory
            exec "$SHELL"
        fi
    else
        echo "Error: Directory does not exist: $target_dir"
        if [ "$is_sourced" = true ]; then return 1; else exit 1; fi
    fi
}

# --- Handle Command Line Arguments (Point 8) ---
if [ $# -gt 0 ]; then
    load_bookmarks
    arg="$1"
    if [[ "$arg" =~ ^[0-9]+$ ]]; then
        num=$((10#$arg))
        if [ -n "${bookmarks[$((num - 1))]+x}" ]; then
            execute_cd "${bookmarks[$((num - 1))]}"
            if [ "$is_sourced" = true ]; then return 0; else exit 0; fi
        else
            echo "Error: Bookmark $num not found."
            if [ "$is_sourced" = true ]; then return 1; else exit 1; fi
        fi
    else
        echo "Error: Bookmark $num not found."
        if [ "$is_sourced" = true ]; then return 1; else exit 1; fi
    fi
fi

# --- Main Loop ---
while true; do
    display_menu
    read -r -p "Select option: " choice
    echo ""
    
    case "$choice" in
        [Qq]*)
            echo "Exiting."
            if [ "$is_sourced" = true ]; then return 0; else exit 0; fi
            ;;
        [Aa]*)
            add_bookmark
            ;;
        [Dd]*)
            delete_bookmark
            ;;
        [0-9]|[1-9][0-9])
            num=$((10#$choice))
            load_bookmarks
            if [ -n "${bookmarks[$((num - 1))]+x}" ]; then
                execute_cd "${bookmarks[$((num - 1))]}"
                if [ "$is_sourced" = true ]; then return 0; else exit 0; fi
            else
                echo "Error: Bookmark $num not found."
            fi
            ;;
        *)
            echo "Invalid option."
            ;;
    esac
done