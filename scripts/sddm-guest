#!/usr/bin/env bash

# Default target user (change 'guest' if your account uses a different name)
TARGET_USER="${1:-guest}"
ACTION="${2:-toggle}"

CONF_DIR="/etc/sddm.conf.d"
CONF_FILE="${CONF_DIR}/hide-users.conf"

# Ensure script is run with root privileges
if [[ $EUID -ne 0 ]]; then
   echo "Error: This script must be run with sudo."
   exit 1
fi

# Ensure SDDM configuration directory exists
if [[ ! -d "/etc/sddm" && ! -d "$CONF_DIR" ]]; then
   echo "Warning: SDDM configuration directory not found. Is SDDM installed?"
fi

is_user_exist() {
    id "$TARGET_USER" &>/dev/null
}

ensure_user_exist() {
    if ! is_user_exist; then
        echo "User '$TARGET_USER' does not exist. Creating guest account..."
        # Create user with home directory and bash shell
        useradd -m -s /bin/bash "$TARGET_USER"
        
        # Set default password 'guest' so guests can easily log in
        echo "${TARGET_USER}:${TARGET_USER}" | chpasswd
        echo "Created user '$TARGET_USER' with password '${TARGET_USER}'."
    fi
}

is_hidden() {
    [[ -f "$CONF_FILE" ]] && grep -qE "^HideUsers=.*\b${TARGET_USER}\b" "$CONF_FILE"
}

show_status() {
    echo "========================================="
    echo " Guest Account Status: $TARGET_USER"
    echo "========================================="
    if is_user_exist; then
        echo " -> System Account: Exists"
    else
        echo " -> System Account: Does NOT exist (will be created when shown)"
    fi
    
    if is_hidden; then
        echo " -> SDDM Visibility: HIDDEN (Strangers cannot see/access)"
    else
        echo " -> SDDM Visibility: VISIBLE (Available on login screen)"
    fi
    
    if [[ -f "$CONF_FILE" ]]; then
        echo ""
        echo "Current hide-users.conf content:"
        cat "$CONF_FILE"
    fi
    echo "========================================="
}

hide_user() {
    if is_hidden; then
        echo "User '$TARGET_USER' is already hidden in SDDM."
        return
    fi

    if [[ ! -f "$CONF_FILE" ]]; then
        printf "[Users]\nHideUsers=%s\n" "$TARGET_USER" > "$CONF_FILE"
    elif grep -q "^HideUsers=" "$CONF_FILE"; then
        # Append user to existing HideUsers line
        sed -i "/^HideUsers=/s/$/,$TARGET_USER/" "$CONF_FILE"
        sed -i "s/=,=/=/; s/=,/$TARGET_USER/" "$CONF_FILE"
    else
        if grep -q "\[Users\]" "$CONF_FILE"; then
            sed -i "/\[Users\]/a HideUsers=$TARGET_USER" "$CONF_FILE"
        else
            printf "\n[Users]\nHideUsers=%s\n" "$TARGET_USER" >> "$CONF_FILE"
        fi
    fi
    echo "Done: User '$TARGET_USER' is now HIDDEN from SDDM."
}

unhide_user() {
    # Ensure the guest account exists when making it visible for strangers
    ensure_user_exist

    if ! is_hidden; then
        echo "User '$TARGET_USER' is already visible in SDDM."
        return
    fi

    # Remove target user and clean up extra commas
    sed -i -E "s/\b${TARGET_USER}\b//g" "$CONF_FILE"
    sed -i -E 's/,+/,/g; s/HideUsers=,/HideUsers=/g; s/,$//g' "$CONF_FILE"

    # Remove the config file if HideUsers line becomes empty
    if grep -qE "^HideUsers=\s*$" "$CONF_FILE"; then
        rm -f "$CONF_FILE"
        echo "Removed empty configuration file ($CONF_FILE)."
    fi

    echo "Done: User '$TARGET_USER' is now VISIBLE in SDDM (Password: '$TARGET_USER')."
}

case "$ACTION" in
    hide)
        hide_user
        ;;
    unhide)
        unhide_user
        ;;
    toggle)
        if is_hidden; then
            unhide_user
        else
            hide_user
        fi
        ;;
    status|list)
        show_status
        ;;
    *)
        echo "Usage: sudo $0 [username] [hide|unhide|toggle|status]"
        echo "Examples:"
        echo "  sudo sddm-guest                # Toggle default 'guest' account visibility"
        echo "  sudo sddm-guest status         # Check guest account & visibility status"
        echo "  sudo sddm-guest hide           # Hide guest account"
        echo "  sudo sddm-guest unhide         # Make guest account visible (creates user if missing)"
        exit 1
        ;;
esac
